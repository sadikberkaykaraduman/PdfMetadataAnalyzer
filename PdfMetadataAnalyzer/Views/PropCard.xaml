<UserControl x:Class="PdfMetadataAnalyzer.Views.PropCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="0,0,8,0">
    <Border Style="{StaticResource CardSmall}">
        <StackPanel>
            <TextBlock Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Style="{StaticResource TextLabel}" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Style="{StaticResource TextHeading}" FontSize="16"/>
        </StackPanel>
    </Border>
</UserControl>