<UserControl x:Class="PdfMetadataAnalyzer.Views.MetadataRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:PdfMetadataAnalyzer.Converters"
             Margin="0,0,0,6">
    <UserControl.Resources>
        <cv:ConfidenceColorConverter  x:Key="ConfColor"/>
        <cv:NullToVisibilityConverter x:Key="NullVis"/>
    </UserControl.Resources>
    <Border Style="{StaticResource CardSmall}" Padding="12,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>

            <TextBlock Grid.Column="1"
                       Text="{Binding Field.Value, RelativeSource={RelativeSource AncestorType=UserControl}, TargetNullValue='—'}"
                       Style="{StaticResource TextBody}" FontSize="12" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Field.Value, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

            <Border Grid.Column="2" Margin="10,0" VerticalAlignment="Center"
                    CornerRadius="4" Padding="7,3" Background="#1F000000"
                    BorderBrush="{Binding Field.Confidence, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ConfColor}}"
                    BorderThickness="1">
                <TextBlock Text="{Binding Field.ConfidenceLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="{Binding Field.Confidence, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ConfColor}}"/>
            </Border>

            <Button Grid.Column="3" Content="⎘"
                    Command="{Binding CopyCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding Field.Value, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Style="{StaticResource BtnSecondary}" Padding="8,4" FontSize="12"
                    ToolTip="Copy to clipboard"/>
        </Grid>
    </Border>
</UserControl>