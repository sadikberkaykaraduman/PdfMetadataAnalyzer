<UserControl x:Class="PdfMetadataAnalyzer.Views.PermBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="0,0,8,0">
    <Border CornerRadius="6" Padding="10,5"
            Background="{StaticResource BgCardBrush}"
            BorderThickness="1">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Allowed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                        <Setter Property="BorderBrush" Value="#3FB950"/>
                        <Setter Property="Background"  Value="#0F3FB950"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel Orientation="Horizontal">
            <TextBlock FontSize="11">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text"       Value="✗ "/>
                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Allowed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="Text"       Value="✓ "/>
                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
        </StackPanel>
    </Border>
</UserControl>