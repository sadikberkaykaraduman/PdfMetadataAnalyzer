<UserControl x:Class="PdfMetadataAnalyzer.Views.RawFieldRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="0,0,0,4">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0"
                   Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1"
                   Text="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}, TargetNullValue='—'}"
                   FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"
                   TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
    </Grid>
</UserControl>