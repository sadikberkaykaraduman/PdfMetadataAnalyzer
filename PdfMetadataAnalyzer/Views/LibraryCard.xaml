<UserControl x:Class="PdfMetadataAnalyzer.Views.LibraryCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:PdfMetadataAnalyzer.Converters"
             xmlns:local="clr-namespace:PdfMetadataAnalyzer.Views">
    <UserControl.Resources>
        <cv:SuccessToIconConverter    x:Key="SuccIcon"/>
        <cv:SuccessToColorConverter   x:Key="SuccColor"/>
        <cv:ScoreColorConverter       x:Key="ScoreColor"/>
        <cv:NullToVisibilityConverter x:Key="NullVis"/>
    </UserControl.Resources>
    <Border Style="{StaticResource Card}">
        <StackPanel DataContext="{Binding Raw, RelativeSource={RelativeSource AncestorType=UserControl}}">

            <Grid Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Success, Converter={StaticResource SuccIcon}}"
                               Foreground="{Binding Success, Converter={StaticResource SuccColor}}"
                               FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Tool}" Style="{StaticResource TextHeading}"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding ElapsedMs}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="ms" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,0"/>
                </StackPanel>
            </Grid>

            <Border Visibility="{Binding Error, Converter={StaticResource NullVis}}"
                    Background="#1FF85149" CornerRadius="4" Padding="8,5" Margin="0,0,0,8">
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" FontSize="11" TextWrapping="Wrap"/>
            </Border>

            <local:RawFieldRow Label="Title"    Value="{Binding Title}"/>
            <local:RawFieldRow Label="Author"   Value="{Binding Author}"/>
            <local:RawFieldRow Label="Subject"  Value="{Binding Subject}"/>
            <local:RawFieldRow Label="Keywords" Value="{Binding Keywords}"/>
            <local:RawFieldRow Label="Creator"  Value="{Binding Creator}"/>
            <local:RawFieldRow Label="Pages"    Value="{Binding PageCount}"/>
            <local:RawFieldRow Label="Words"    Value="{Binding WordCount}"/>
            <local:RawFieldRow Label="Fields Found" Value="{Binding FieldsFound}"/>

            <Separator Margin="0,8"/>
            <Grid>
                <TextBlock Text="Accuracy Score" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding AccuracyScore, StringFormat='{}{0:F1}'}"
                           HorizontalAlignment="Right"
                           Foreground="{Binding AccuracyScore, Converter={StaticResource ScoreColor}}"
                           FontWeight="Bold" FontSize="13"/>
            </Grid>
            <ProgressBar Value="{Binding AccuracyScore}" Maximum="100" Margin="0,4,0,0"
                         Foreground="{Binding AccuracyScore, Converter={StaticResource ScoreColor}}"/>
        </StackPanel>
    </Border>
</UserControl>